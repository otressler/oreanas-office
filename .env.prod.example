# Deployment variables for infra/deploy.ps1. Copy to .env.prod (gitignored) and fill in.
# KEY=VALUE per line; quotes around a value are optional. No inline comments: a secret may
# contain #. Variables already set in the shell win over this file.

# Microsoft Entra admin of the SQL server:
#   az ad signed-in-user show --query userPrincipalName --output tsv
#   az ad signed-in-user show --query id --output tsv
SQL_ENTRA_ADMIN_LOGIN=
SQL_ENTRA_ADMIN_OBJECT_ID=

# Receives the $10 and $30 budget alerts.
BUDGET_CONTACT_EMAIL=

# Sign-in with Google (Google Cloud Console -> Google Auth Platform -> Clients). The client's
# redirect URIs must include https://oreanas-office.otressler.de/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Becomes site admin on its first verified Google sign-in.
ADMIN_EMAIL=

# Only for a private ghcr.io package: GitHub user and a classic PAT with read:packages.
GHCR_USERNAME=
GHCR_TOKEN=

# Optional: your public IP, so you can run infra/sql/grant-app-access.sql from this machine.
# It changes, so it's usually better set in the shell for that one run:
#   $env:SQL_CLIENT_IP = (Invoke-RestMethod https://api.ipify.org)
SQL_CLIENT_IP=
