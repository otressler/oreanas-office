  "components": {
    "schemas": {
      "ActiveSessionSummary": {
        "required": [
          "id",
          "title",
          "date",
          "dmUserId",
          "dmDisplayName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "dmUserId": {
            "type": "string",
            "format": "uuid"
          },
          "dmDisplayName": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ApiErrorCode"
          },
          "field": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ApiErrorCode": {
        "enum": [
          "inviteInvalid",
          "emailInvalid",
          "emailTaken",
          "passwordTooShort",
          "displayNameInvalid",
          "invalidCredentials",
          "lockedOut",
          "resetLinkInvalid",
          "googleFailed",
          "googleNoInvite",
          "googleEmailTaken",
          "googleAccountInUse",
          "googleAlreadyLinked",
          "nameInvalid",
          "joinCodeInvalid",
          "speedInvalid",
          "notADm",
          "anotherSessionActive",
          "sessionEnded"
        ]
      },
      "AuthOptionsResponse": {
        "required": [
          "googleEnabled"
        ],
        "type": "object",
        "properties": {
          "googleEnabled": {
            "type": "boolean"
          }
        }
      },
      "CampaignResponse": {
        "required": [
          "id",
          "name",
          "defaultDmUserId",
          "myRole",
          "joinCode",
          "activeSessionId",
          "members"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "defaultDmUserId": {
            "type": "string",
            "format": "uuid"
          },
          "myRole": {
            "$ref": "#/components/schemas/CampaignRole"
          },
          "joinCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "activeSessionId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberResponse"
            }
          }
        }
      },
      "CampaignRole": {
        "enum": [
          "dm",
          "player"
        ]
      },
      "CampaignSummaryResponse": {
        "required": [
          "id",
          "name",
          "myRole",
          "activeSession"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "myRole": {
            "$ref": "#/components/schemas/CampaignRole"
          },
          "activeSession": {
            "oneOf": [
              {
