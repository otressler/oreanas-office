<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 asks every call in a test to pass TestContext.Current.CancellationToken; the shared test helpers don't take one, and threading it through every call isn't worth the noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <!-- The server's Blob data protection package pulls in 10.0.10, below the fix for GHSA-r955-8q5j-3h83. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="Testcontainers.Azurite" Version="4.16.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample maps the frontend offers; import tests read them from SampleMaps/. -->
    <None Include="..\..\src\web\src\samples\maps\*.json" LinkBase="SampleMaps" CopyToOutputDirectory="PreserveNewest" />
    <!-- The frontend's board fixtures for the sample maps; import tests compare against them. -->
    <None Include="..\..\src\web\src\board\fixtures\*.board.json" LinkBase="BoardFixtures" CopyToOutputDirectory="PreserveNewest" />
    <!-- The OpenAPI document the frontend generates its types from; the hub contract test reads it. -->
    <None Include="..\..\src\web\src\api\openapi.json" Link="openapi.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Server\OreanasOffice.Server.csproj" />
  </ItemGroup>

</Project>